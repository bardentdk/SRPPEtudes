# --- Bouton « Actualiser les données » (route /api/refresh) ---
# Jeton GitHub fine-grained limité au dépôt, permission « Actions : Read and write »
GITHUB_TOKEN=
# Dépôt au format owner/repo
GITHUB_REPOSITORY=
# Branche sur laquelle lancer le workflow (main par défaut)
GITHUB_BRANCH=main

# --- Questionnaire et espace admin (Supabase, région UE) ---
NEXT_PUBLIC_SUPABASE_URL=
# Clé anon (ou « publishable ») : publique, sert uniquement à la connexion admin
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role (ou « secret ») : serveur uniquement, ne jamais l'exposer
SUPABASE_SERVICE_ROLE_KEY=
# Adresses autorisées dans l'espace admin, séparées par des virgules
ADMIN_EMAILS=
# Chaîne aléatoire longue, pour l'empreinte des adresses IP (limitation des envois)
IP_HASH_SALT=
# Adresse de contact affichée dans la page « Données personnelles »
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Copie des réponses dans Google Sheets (questionnaire/reception.gs) ---
SHEET_WEBHOOK_URL=
SHEET_WEBHOOK_TOKEN=

# --- Analyse IA (Groq) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
