# --- Bouton « Actualiser les données » (route /api/refresh) ---
# Jeton GitHub fine-grained limité au dépôt, permission « Actions : Read and write »
GITHUB_TOKEN=
# Dépôt au format owner/repo
GITHUB_REPOSITORY=
# Branche sur laquelle lancer le workflow (main par défaut)
GITHUB_BRANCH=main

# --- Questionnaire et espace admin (Neon + Better Auth) ---
# Chaîne de connexion Neon (branche dev en local, production sur Vercel). Variable serveur :
# ne jamais lui donner le préfixe NEXT_PUBLIC_.
DATABASE_URL=
# Secret de signature des sessions : openssl rand -hex 32
BETTER_AUTH_SECRET=
# Adresse du site (http://localhost:3000 en local, https://… en production)
BETTER_AUTH_URL=
# Adresses autorisées dans l'espace admin, séparées par des virgules
ADMIN_EMAILS=
# Chaîne aléatoire longue, pour l'empreinte des adresses IP (limitation des envois)
IP_HASH_SALT=
# Adresse de contact affichée dans la page « Données personnelles »
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Copie des réponses dans Google Sheets (questionnaire/reception.gs) ---
SHEET_WEBHOOK_URL=
SHEET_WEBHOOK_TOKEN=

# --- Analyse IA (Groq) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
